#!/bin/sh
# Bump the pull number in config/github.php on every commit.
FILE="config/github.php"

# Skip if nothing is staged.
git diff --cached --quiet && exit 0

# Read the current number from the staged version of the file.
CURRENT=$(git show ":$FILE" 2>/dev/null | grep -o "'pull_number' => [0-9]\+" | grep -o '[0-9]\+$')
[ -z "$CURRENT" ] && exit 0
NEXT=$((CURRENT + 1))

bump() {
    sed "s/'pull_number' => [0-9]\+/'pull_number' => $NEXT/"
}

# Update the staged copy only, so unrelated unstaged edits in the file stay unstaged.
MODE=$(git ls-files -s "$FILE" | cut -d' ' -f1)
BLOB=$(git show ":$FILE" | bump | git hash-object -w --stdin)
git update-index --cacheinfo "$MODE,$BLOB,$FILE"

# Update the working copy too, so it matches.
if [ -f "$FILE" ]; then
    bump < "$FILE" > "$FILE.tmp" && mv "$FILE.tmp" "$FILE"
fi

echo "pre-commit: pull number $CURRENT -> $NEXT"
